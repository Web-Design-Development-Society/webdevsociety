---
import '../styles/global.css';
import BasicLayout from '../layouts/sitelayout.astro';
import heroImage from '../assets/images/projects.jpg';
import ProjectCard from '../components/projects/projectcard.astro';
import currentProjects from '../content/projects/currentprojects.json';
import pastProjects from '../content/projects/pastprojects.json';
import HeroBanner from '../components/navigation/HeroBanner.astro';
---

<BasicLayout
  title="BYUI WDD Society - Projects"
  description="We regularly work on collaborative projects that meet real-world needs and provide a learning environment for students of all levels of experience."
  bannerImage={heroImage}
>
  <HeroBanner heroImage={heroImage}>
    <h1 class="text-6xl font-bold">Projects</h1>
    <span class="w-2/3 text-center md:w-1/2">
      Some of the projects that members have done work on or are currently working on.
    </span>
  </HeroBanner>

  <section id="current-projects" class="flex flex-col items-center py-5">
    <h2 class="text-4xl font-bold">Current Projects</h2>
    <ul class="mx-10 flex flex-col items-center md:mx-0 md:w-1/2">
      <!-- Use currentprojects.json to populate the list of current projects -->
      {
        currentProjects.map(
          (item: {
            title: string;
            url: string;
            img: string;
            alt: string;
            desc: string;
            startDate: string;
            endDate: string;
            contributors: string[];
          }) => (
            <li>
              <ProjectCard project={item} />
            </li>
          )
        )
      }
    </ul>
  </section>

  <section id="past-projects" class="flex flex-col items-center py-5">
    <h2 class="text-4xl font-bold">Past Projects</h2>
    <ul class="mx-10 flex flex-col items-center md:mx-0 md:w-1/2">
      <!-- Use pastprojects.json to populate the list of current projects -->
      {
        pastProjects.map(
          (item: {
            title: string;
            url: string;
            img: string;
            alt: string;
            desc: string;
            startDate: string;
            endDate: string;
            contributors: string[];
          }) => (
            <li>
              <ProjectCard project={item} />
            </li>
          )
        )
      }
    </ul>
  </section>
</BasicLayout>
