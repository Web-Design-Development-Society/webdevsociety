---
import '../styles/global.css';
import BasicLayout from '../layouts/sitelayout.astro';
import HeroBanner from '../components/navigation/HeroBanner.astro';
import heroImage from '../assets/images/hero-banner.jpg';
import variables from '../assets/data/variables.json';

const BASE_URL = import.meta.env.BASE_URL;
---

<BasicLayout
  description="The official website for the Brigham Young University-Idaho Web Design and Development Society. Improve your skills. Build personal websites to showcase yourself and your projects. Learn new technologies and develop alongside your peers."
  bannerImage={heroImage}
>
  <HeroBanner heroImage={heroImage} variant="landing">
    <div class="flex h-fit flex-col gap-3 rounded-sm bg-gray-50 p-5 shadow-md dark:bg-gray-900">
      <span class="text-center text-2xl font-bold md:text-left">Build Websites</span>
      <p class="text-gray-700 dark:text-gray-300">
        Improve your skills. Build personal websites to showcase yourself and your projects. Learn
        new technologies and develop alongside your peers.
      </p>
      <a
        href={`${BASE_URL}/members`}
        class="self-center rounded-full bg-blue-950 px-3 py-2 text-white hover:bg-gray-800"
      >
        Meet the Society
      </a>
    </div>
  </HeroBanner>

  <section id="quote" class="bg-blue-950 py-3 text-white">
    <div class="mx-auto flex w-fit flex-col items-center gap-3 md:flex-row">
      <span class="text-center font-bold">
        "Increase your focus on those things that really matter."
      </span>
      <span>- Alvin F. Meredith III</span>
    </div>
  </section>

  <section id="about" class="flex flex-col py-10 md:flex-row md:px-20">
    <div
      id="presidency-message"
      class="md:mx-none mx-auto flex w-2/3 flex-col items-center justify-center gap-10"
    >
      <span class="text-center text-5xl font-light">Mission Statement</span>
      <div class="mx-auto flex flex-col gap-3 text-justify md:w-1/2">
        <p>
          The BYU-I Web Design and Development Society is dedicated to fostering a vibrant and
          collaborative community for students passionate about creating digital experiences.
        </p>
        <p>
          Our mission is to spark interest in web development by providing hands-on learning
          opportunities, promoting innovative design, and connecting members with real-world
          industry insights.
        </p>
        <p>
          Through workshops, projects, and mentorship, we empower students to develop their skills,
          explore creative solutions, and prepare for successful careers in web development.
          Together, we aim to inspire the next generation of web creators.
        </p>
      </div>
    </div>

    <div class="flex flex-col items-center gap-5 pt-15 md:w-1/3 md:py-0">
      <div id="society-info" class="w-3/4 rounded-sm bg-blue-950 p-5 text-white">
        <span class="font-bold">Information</span>
        <ul class="list-disc pl-5">
          <li>
            <div class="flex gap-2">
              <span class="font-bold">Where:</span>
              <span>{variables.room}</span>
            </div>
          </li>
          <li>
            <div class="flex gap-2">
              <span class="font-bold">When:</span>
              <span>{variables.day},</span>
              <span>{variables.time}</span>
            </div>
          </li>
        </ul>
      </div>

      <div id="values" class="w-3/4 rounded-sm bg-blue-950 p-5 text-white">
        <span class="font-bold">Our Values</span>
        <ul class="list-disc pl-5">
          <li>Creativity</li>
          <li>Connection</li>
          <li>Accessibility</li>
          <li>Innovative Design</li>
        </ul>
      </div>
      <div id="goals" class="w-3/4 rounded-sm bg-blue-950 p-5 text-white">
        <span class="font-bold">Our Goals</span>
        <ul class="list-disc pl-5">
          <li>Hands-On Practice</li>
          <li>Develop Personal Networks</li>
          <li>Learn from Professionals</li>
          <li>Build Resumes</li>
        </ul>
      </div>
    </div>
  </section>
</BasicLayout>
