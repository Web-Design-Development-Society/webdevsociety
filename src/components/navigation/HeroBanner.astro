---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heroImage: ImageMetadata;
  imagePosition?: 'bg-center' | 'bg-top' | 'bg-bottom';
  variant?: 'landing' | 'centered';
}

const { heroImage, imagePosition = 'bg-center', variant = 'centered' } = Astro.props;
---

<section id="hero-banner" class="relative flex h-96 w-full overflow-hidden bg-blue-950">
  <Image
    src={heroImage}
    alt=""
    priority={true}
    aria-hidden="true"
    class={`absolute inset-0 h-full w-full object-cover z-0 ${
      imagePosition === 'bg-top'
        ? 'object-top'
        : imagePosition === 'bg-bottom'
          ? 'object-bottom'
          : 'object-center'
    }`}
  />

  <div class="absolute inset-0 z-10 bg-black/50"></div>

  <div class="relative z-20 flex h-full w-full">
    {
      variant === 'landing' ? (
        <>
          <div class="flex flex-col-reverse px-5 pb-5 md:w-1/4 md:px-0 md:pl-10">
            <slot />
          </div>
          <div class="md:w-3/4">
            <span class="hidden"> </span>
          </div>
        </>
      ) : (
        <div class="flex w-full flex-col items-center justify-center gap-3 text-white">
          <slot />
        </div>
      )
    }
  </div>
</section>
