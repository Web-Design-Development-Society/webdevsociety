---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Project = {
  title: string;
  url: string;
  img: string;
  alt: string;
  desc: string;
  startDate: string;
  endDate: string;
  contributors: string[];
};

let timeFrame;

export interface Props {
  project: Project;
}

const { project } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpeg,jpg,png,gif}'
);

const imagePath = project.img;
if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob.`);

if (project.startDate != project.endDate) {
  timeFrame = `${project.startDate} - ${project.endDate}`;
} else {
  timeFrame = `${project.startDate}`;
}

const contributors = project.contributors.length;
---

<a href={project.url} target="_blank" rel="noopener noreferrer">
  <article class="group relative my-10 gap-5 overflow-hidden rounded-xl shadow-md dark:bg-gray-700">
    <Image src={(await images[imagePath]()).default} alt={project.alt} />
    <div
      class="transition duration-300 group-hover:opacity-100 md:absolute md:top-0 md:left-0 md:h-full md:w-full md:opacity-0 md:backdrop-blur-md"
    >
      <div
        class="flex flex-col gap-5 p-5 md:h-full md:w-1/2 md:justify-center md:bg-black md:text-white lg:w-1/3 md:dark:bg-neutral-100 md:dark:text-black"
      >
        <div class="flex flex-col items-center">
          <h3 class="text-center text-3xl">{project.title}</h3>
          <span class="font-sm text-gray-400 italic">{timeFrame}</span>
        </div>
        <p class="mx-auto w-9/10 text-justify">{project.desc}</p>
        {
          contributors != 0 && (
            <div class="flex flex-col items-center md:mx-auto md:w-9/10 md:items-start">
              <span class="md:text-md text-lg font-bold">Contributors</span>
              <ul class="flex flex-col items-center gap-1 md:items-start md:pl-5">
                {project.contributors.map((contributor) => (
                  <li>{contributor}</li>
                ))}
              </ul>
            </div>
          )
        }
        <span class="mx-auto rounded-full bg-black px-3 py-2 text-white md:hidden">
          View the project
        </span>
      </div>
      <div class="w-2/3 backdrop-blur-none"></div>
    </div>
  </article>
</a>
